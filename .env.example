# Set these in the Vercel project settings (never commit real values).
SUPABASE_URL=
# Service-role key: full database access. Server-side only.
SUPABASE_SERVICE_ROLE=
# Shared secret clients must send in the x-api-key header.
API_KEY=
# Optional: Discord-style webhook for alerts ({"content": "..."}).
ALERT_WEBHOOK=
# Optional: Supabase Storage bucket for raw evidence (default: evidence).
EVIDENCE_BUCKET=evidence
